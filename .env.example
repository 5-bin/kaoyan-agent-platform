# Generate secrets with python scripts/init-env.py; edit DB credentials locally.
AGENT_INTERNAL_KEY=
JWT_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kaoyan
DB_USER=kaoyan_app
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
AGENT_BASE_URL=http://127.0.0.1:8001
QUOTA_EXEMPT_USERNAME=robin
DAILY_TASK_LIMIT=30
MINUTE_TASK_LIMIT=6
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL_ROUTER=glm-4-flash
LLM_MODEL_MAIN=glm-4-plus
# DeepSeek official V4.1 Flash: use https://api.deepseek.com and deepseek-flash
# for both LLM_MODEL_MAIN and LLM_MODEL_ROUTER; keep its API key local.
# default omits provider-specific thinking parameters.
# Set enabled/disabled explicitly only when the configured provider supports it.
LLM_THINKING_MODE=default
MAX_MODEL_CALLS_PER_DAY=100
# Seconds: parser + experts + summary must fit the task timeout (< Java's 48s guard).
CONVERSATION_PARSE_TIMEOUT=10
CONVERSATION_EXPERT_TIMEOUT=28
CONVERSATION_STEP_TIMEOUT=12
CONVERSATION_SUMMARY_TIMEOUT=4
AGENT_TASK_TIMEOUT=42
# Local input estimates include instructions/schema/JSON; no tokenizer download.
MODEL_CONTEXT_WINDOW=32768
MODEL_CONTEXT_RESERVE=2048
MODEL_INPUT_TOKENS=12000
MODEL_OUTPUT_TOKENS=2200
PLAN_INPUT_TOKENS=8000
PLAN_OUTPUT_TOKENS=2048
NOTE_INPUT_TOKENS=20000
NOTE_OUTPUT_TOKENS=4096
STUDY_OUTPUT_TOKENS=8192
# lexical: offline baseline; qdrant: run ingest.py first (downloads embedding weights once).
RAG_BACKEND=lexical
# local keeps the original tool; mcp_stdio uses the fixed read-only child.
# Requires the current requirements; no arbitrary server command or URL is accepted.
KNOWLEDGE_TOOL_TRANSPORT=local
# Optional absolute path shared by Java/Python; defaults to config/reference-hosts.json
# (Java packages the same source into its JAR). Rebuild/reload after policy changes.
# RAG_SOURCE_POLICY_FILE=/absolute/path/to/reference-hosts.json
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Independent local question index; does not use the knowledge/school Qdrant store.
QUESTION_MIN_SCORE=0.75
# QUESTION_INDEX=/absolute/path/to/question-index
# Empty URL selects an independent local persistent Qdrant database.
QDRANT_URL=
QDRANT_API_KEY=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_URL_PREFIX=
# Empty locally; use prod/ for the shared Bucket on the server.
OSS_KEY_PREFIX=

# Local registered admission URLs through a separate stdio MCP service (default off; no website requests)
ADMISSION_MCP_ENABLED=false

# Enable only after explicitly applying V13 to the target database; startup never migrates it.
KAOYAN_LEARNING_ENABLED=false
