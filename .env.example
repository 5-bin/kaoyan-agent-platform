# 复制为 .env 后填写，不要上传 .env。内部密钥至少16位ASCII字符。
AGENT_INTERNAL_KEY=
DB_PASSWORD=
AGENT_MODE=demo
# MODEL_BASE_URL 填供应商文档中的 /v1 等接口根地址；程序追加 /chat/completions。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MAX_MODEL_CALLS_PER_DAY=100
DAILY_TASK_LIMIT=30
MINUTE_TASK_LIMIT=6
# 仅启用 public profile 时使用；本地默认不申请证书。
SITE_ADDRESS=http://localhost
