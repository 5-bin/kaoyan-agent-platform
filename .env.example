# Generate secrets with python scripts/init-env.py; edit DB credentials locally.
AGENT_INTERNAL_KEY=
JWT_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kaoyan
DB_USER=kaoyan_app
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
AGENT_BASE_URL=http://127.0.0.1:8001
DAILY_TASK_LIMIT=30
MINUTE_TASK_LIMIT=6
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL_ROUTER=glm-4-flash
LLM_MODEL_MAIN=glm-4-plus
MAX_MODEL_CALLS_PER_DAY=100
# lexical: offline baseline; qdrant: run ingest.py first (downloads embedding weights once).
RAG_BACKEND=lexical
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Empty URL selects an independent local persistent Qdrant database.
QDRANT_URL=
QDRANT_API_KEY=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_URL_PREFIX=
