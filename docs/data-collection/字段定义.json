{
  "format": "collection-v3",
  "createdAt": "2026-10-24",
  "xlsxDataStartRow": 3,
  "csvEncoding": "UTF-8",
  "multiValueSeparator": ";",
  "inputRows": 500,
  "referenceSheets": [
    "分工与说明",
    "题库配额",
    "字段字典"
  ],
  "schoolScope": "全部985／211院校并集去重；基线名单待逐校编制复核",
  "questionTarget": {
    "acceptedPerSubject": {
      "EASY": 30,
      "MEDIUM": 40,
      "HARD": 30
    },
    "acceptedTotal": 400,
    "collectPerSubject": {
      "EASY": 36,
      "MEDIUM": 48,
      "HARD": 36
    },
    "collectTotal": 480,
    "existingQuestionsCountTowardTarget": false,
    "replacementPlan": "先完整收集并审核新题，再替换现有44题；保留历史依据；当前不执行数据库操作"
  },
  "sheets": [
    {
      "name": "来源",
      "file": "sources",
      "fields": [
        {
          "key": "sourceId",
          "label": "来源编号",
          "required": "是",
          "type": "text",
          "rule": "SRC-成员前缀-序号；稳定且全包唯一"
        },
        {
          "key": "sourceKind",
          "label": "来源类型",
          "required": "是",
          "type": "text",
          "rule": "来源性质，与题目来源类别分别填写",
          "values": [
            "OFFICIAL_ADMISSION",
            "TEXTBOOK",
            "COURSE",
            "OPEN_RESOURCE",
            "ORIGINAL_RECORD"
          ]
        },
        {
          "key": "title",
          "label": "来源标题",
          "required": "是",
          "type": "text",
          "rule": "准确书名／公告／讲义名称；题目转换来源名最多255字符"
        },
        {
          "key": "author",
          "label": "作者或机构",
          "required": "是",
          "type": "text",
          "rule": "按原文署名，不编造原创作者"
        },
        {
          "key": "url",
          "label": "具体原文链接",
          "required": "条件",
          "type": "text",
          "rule": "无凭证HTTPS具体页；url与filePath至少一项；Agent目前必须有可引用HTTPS链接"
        },
        {
          "key": "locator",
          "label": "原文定位",
          "required": "是",
          "type": "text",
          "rule": "章节／页码／表格行／原题号／动态查询条件"
        },
        {
          "key": "sourceVersion",
          "label": "原文版本",
          "required": "是",
          "type": "text",
          "rule": "官方文件版本、教材版次或明确标注的采集快照版本"
        },
        {
          "key": "publishedAt",
          "label": "原文发布日期",
          "required": "否",
          "type": "date",
          "rule": "查不到留空，不以获取日期替代"
        },
        {
          "key": "retrievedAt",
          "label": "实际获取日期",
          "required": "是",
          "type": "date",
          "rule": "YYYY-MM-DD，不填未来日期"
        },
        {
          "key": "permissionStatus",
          "label": "权限状态",
          "required": "是",
          "type": "text",
          "rule": "只表示拟用方式，权限未知不可发布",
          "values": [
            "PENDING",
            "ALLOWED",
            "LINK_ONLY",
            "PROHIBITED"
          ]
        },
        {
          "key": "permissionNote",
          "label": "允许用途及署名",
          "required": "是",
          "type": "text",
          "rule": "具体拟用方式、署名与限制；非空不等于许可已核验"
        },
        {
          "key": "permissionEvidence",
          "label": "权限证据",
          "required": "通过时",
          "type": "text",
          "rule": "许可页HTTPS或包内授权记录路径；不得填写秘密凭证"
        },
        {
          "key": "filePath",
          "label": "原文证据文件",
          "required": "条件",
          "type": "path",
          "rule": "包内普通文件相对路径；与url至少一项；按许可留存"
        },
        {
          "key": "fileSha256",
          "label": "证据SHA-256",
          "required": "否",
          "type": "text",
          "rule": "合并负责人针对filePath实际文件计算64位十六进制值"
        },
        {
          "key": "recordVersion",
          "label": "采集版本",
          "required": "是",
          "type": "integer",
          "rule": "从1开始；内容修订增加；不是数据库题目version"
        },
        {
          "key": "collectedBy",
          "label": "收集人",
          "required": "是",
          "type": "text",
          "rule": "真实成员姓名或团队可识别代号"
        },
        {
          "key": "reviewStatus",
          "label": "收集审核状态",
          "required": "是",
          "type": "text",
          "rule": "收集流程状态，不直接设置数据库发布状态",
          "values": [
            "DRAFT",
            "PENDING_REVIEW",
            "APPROVED",
            "REJECTED",
            "CONFLICT"
          ]
        },
        {
          "key": "reviewer",
          "label": "复核人",
          "required": "审核后",
          "type": "text",
          "rule": "真实复核人；未复核留空"
        },
        {
          "key": "reviewedAt",
          "label": "复核日期",
          "required": "审核后",
          "type": "date",
          "rule": "实际复核日期；YYYY-MM-DD"
        },
        {
          "key": "reviewNote",
          "label": "审核说明",
          "required": "审核后",
          "type": "text",
          "rule": "说明复核范围、依据及问题；驳回／冲突须具体原因"
        }
      ]
    },
